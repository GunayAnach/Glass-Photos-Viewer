<Window
    x:Class="GlassPhotos.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Glass Photos">

    <Grid Background="#111111" KeyDown="Window_KeyDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <CommandBar Grid.Row="0" Background="#CC1A1A1A" DefaultLabelPosition="Right">
            <AppBarButton Icon="OpenFile" Label="Open" Click="Open_Click" />
            <AppBarSeparator />
            <AppBarButton x:Name="PreviousButton" Icon="Back" Label="Previous" Click="Previous_Click" IsEnabled="False" />
            <AppBarButton x:Name="NextButton" Icon="Forward" Label="Next" Click="Next_Click" IsEnabled="False" />
            <AppBarSeparator />
            <AppBarButton Icon="Rotate" Label="Rotate left" IsEnabled="False" ToolTipService.ToolTip="Persistent rotation is the next implementation milestone" />
            <AppBarButton Icon="Rotate" Label="Rotate right" IsEnabled="False" ToolTipService.ToolTip="Persistent rotation is the next implementation milestone" />
            <AppBarButton x:Name="RenameButton" Icon="Rename" Label="Rename" Click="Rename_Click" IsEnabled="False" />
            <AppBarButton x:Name="DeleteButton" Icon="Delete" Label="Recycle" Click="Delete_Click" IsEnabled="False" />
        </CommandBar>

        <Grid Grid.Row="1">
            <Image x:Name="PhotoImage" Stretch="Uniform" Margin="12" />
            <StackPanel x:Name="WelcomePanel" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                <FontIcon Glyph="&#xEB9F;" FontSize="56" Foreground="#999999" />
                <TextBlock Text="Glass Photos for Windows" FontSize="24" Foreground="White" HorizontalAlignment="Center" />
                <TextBlock Text="Open a photo to load its folder and browse with Left and Right." Foreground="#BBBBBB" />
                <Button Content="Open photo" HorizontalAlignment="Center" Click="Open_Click" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="2" Background="#CC1A1A1A" Padding="12,8">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="FileNameText" Text="No photo selected" Foreground="White" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="PositionText" Grid.Column="1" Foreground="#BBBBBB" />
            </Grid>
        </Border>
    </Grid>
</Window>
